# PharmaBridge Environment Configuration
APP_ENV=demo
APP_NAME=PharmaBridge
DEMO_MODE=true
PHARMACY_TIMEZONE=Asia/Kolkata

# PostgreSQL Database
# For local host development: postgresql+asyncpg://pharmabridge:pharmabridge_dev_password@localhost:5432/pharmabridge
# For docker compose: postgresql+asyncpg://pharmabridge:pharmabridge_dev_password@db:5432/pharmabridge
DATABASE_URL=postgresql+asyncpg://pharmabridge:pharmabridge_dev_password@localhost:5432/pharmabridge
POSTGRES_DB=pharmabridge
POSTGRES_USER=pharmabridge
POSTGRES_PASSWORD=pharmabridge_dev_password

# Authentication & Sessions
SESSION_SECRET=dev_session_secret_replace_in_production_min_32_bytes_long
SESSION_COOKIE_NAME=pharmabridge_session
SESSION_COOKIE_SECURE=false
SESSION_ABSOLUTE_TTL_SECONDS=28800
SESSION_IDLE_TTL_SECONDS=1800
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# File Uploads & Retention
UPLOAD_DIRECTORY=data/private-uploads
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=5
UPLOAD_RETENTION_HOURS=24

# Vision & OCR
VISION_PROVIDER=tesseract
VISION_MODEL=
GEMINI_API_KEY=
EXTERNAL_VISION_ENABLED=false

# Background Jobs & Worker
JOB_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=120

# Business Rules & Policies
QUOTE_TTL_SECONDS=300
PRICE_MAX_AGE_DAYS=30
EXPIRY_BUFFER_DAYS=30
CATALOG_REFRESH_ENABLED=false

# Demo Accounts
DEMO_ADMIN_PASSWORD=DemoAdminPass123!
DEMO_PHARMACIST_PASSWORD=DemoPharmacistPass123!
DEMO_ASSISTANT_PASSWORD=DemoAssistantPass123!

# Frontend Public Configuration
VITE_API_BASE_URL=/api/v1
