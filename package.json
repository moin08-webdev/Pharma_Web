{
  "name": "pharmabridge-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "PharmaBridge - AI-assisted prescription fulfilment workspace for Indian pharmacies",
  "scripts": {
    "dev": "python scripts/dev.py",
    "dev:web": "pnpm --filter @pharmabridge/web dev",
    "dev:api": "uv run --project apps/api uvicorn app.main:app --reload --port 8000",
    "dev:worker": "uv run --project apps/api python -m app.worker",
    "build": "pnpm --filter @pharmabridge/web build",
    "lint": "pnpm --filter @pharmabridge/web lint && uv run --project apps/api ruff check .",
    "typecheck": "pnpm --filter @pharmabridge/web typecheck",
    "test": "uv run --project apps/api pytest && pnpm --filter @pharmabridge/web test",
    "test:unit": "uv run --project apps/api pytest tests/unit",
    "test:integration": "uv run --project apps/api pytest tests/integration",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "db:migrate": "uv run --project apps/api alembic upgrade head",
    "db:seed": "uv run --project apps/api python -m app.seed.seed_demo",
    "api:generate": "python scripts/generate_api_client.py",
    "check": "python scripts/check.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "typescript": "^5.7.3"
  }
}
